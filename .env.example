# ==============================================================================
# smart-api-search — variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# El archivo .env NO se versiona (ver .gitignore).
# ==============================================================================

# ── IBM Developer Portal ──────────────────────────────────────────────────────
# Requerido solo cuando EMBED_PROVIDER=portal o al ejecutar ingesta en modo portal.
# Si IBM_PORTAL_AUTH=false, las variables IAM pueden dejarse vacías (RF-01.2).
IBM_PORTAL_HOST=https://your-portal.example.com
IBM_PORTAL_AUTH=true
IBM_TOKEN_URL=https://iam.cloud.ibm.com/identity
IBM_INSTANCE_ID=your-instance-id
IBM_API_KEY=your-ibm-api-key
# Desactivar verificación SSL solo en entornos de desarrollo con certs no confiables (RF-01.3)
IBM_PORTAL_VERIFY_SSL=true

# ── Qdrant Cloud ──────────────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=smart-api-search

# ── Proveedor de embeddings activo (ADR-014) ──────────────────────────────────
# Valores posibles: openai | watsonx
EMBED_PROVIDER=openai

# ── Dimensión del vector denso (ADR-009) ──────────────────────────────────────
# IMPORTANTE: este valor debe coincidir con el proveedor activo.
# Cambiarlo invalida la colección Qdrant y obliga a reindexar (ver SRS §2.3 ⚠).
#   EMBED_PROVIDER=openai  → EMBED_DIM=1024
#   EMBED_PROVIDER=watsonx → EMBED_DIM=768
EMBED_DIM=1024

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Requerido cuando EMBED_PROVIDER=openai o para el LLM generativo (enriquecimiento + HyDE).
OPENAI_API_KEY=your-openai-api-key
# Modelo de embeddings (no cambiar sin actualizar EMBED_DIM y reindexar)
OPENAI_EMBED_MODEL=text-embedding-3-large

# ── IBM Watsonx ───────────────────────────────────────────────────────────────
# Requerido cuando EMBED_PROVIDER=watsonx.
# Modelo: ibm/granite-embedding-278m-multilingual | dims: 768 | ventana: 512 tokens
WATSONX_API_KEY=your-watsonx-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_EMBED_MODEL=ibm/granite-embedding-278m-multilingual

# ── HyDE — expansión de consulta (ADR-008) ───────────────────────────────────
# true  → expande la consulta con LLM antes de embeber (mejor recall, más latencia)
# false → embebe la consulta original directamente (más rápido, sin llamada LLM)
HYDE_ENABLED=true

# ── Ingesta desde archivos locales (F-07) ────────────────────────────────────
# Directorio con archivos .json / .yaml / .yml de specs OpenAPI locales.
LOCAL_SPECS_DIR=./specs

# ── Servidor MCP (F-06) ──────────────────────────────────────────────────────
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
